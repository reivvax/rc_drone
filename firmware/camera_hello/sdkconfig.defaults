# Applied when sdkconfig is (re)generated. Board: XIAO ESP32S3 Sense.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Console on native USB only. With UART0 as primary, every printf also
# blocks on a 115200-baud UART (~11 KB/s), which throttles image transfer.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
